fun getPendingRequests(conn: Int) -> Result<String, List<Json>> {
    result = rpc(conn, 90, "agentManager/pending", {})?
    match jsonGet(result, "data") {
        Some(JArr(items)) -> Ok(items)
        _ -> Fail("supervisor returned no pending request data")
    }
}

fun pendingRequestLabel(item: Json) -> String {
    request = fieldObject(item, "request")
    fieldString(item, "ticket", "?") ++ "  [" ++ fieldString(item, "state", "unknown") ++ "]  " ++ fieldString(request, "method", "?")
}

fun printPendingRequests(conn: Int) -> Result<String, Nil> {
    items = getPendingRequests(conn)?
    if len(items) == 0 {
        print("No pending requests")
    } else {
        print("TICKET\tSTATE\tMETHOD\tTHREAD\tCREATED\tEXPIRES\tDETAILS")
        for item in items {
            request = fieldObject(item, "request")
            params = fieldObject(request, "params")
            detailText = fieldString(params, "reason", fieldString(params, "message", ""))
            detail = if detailText == "" { renderJson(params) } else { detailText }
            print(fieldString(item, "ticket", "?") ++ "\t" ++
                fieldString(item, "state", "unknown") ++ "\t" ++
                fieldString(request, "method", "?") ++ "\t" ++
                fieldString(params, "threadId", "-") ++ "\t" ++
                show(fieldInt(item, "createdAt", 0)) ++ "\t" ++
                show(fieldInt(item, "expiresAt", 0)) ++ "\t" ++ detail)
        }
    }
    Ok(nil)
}

fun respondToPending(conn: Int, ticket: String, action: String, answer: String) -> Result<String, Nil> {
    rpc(conn, 91, "agentManager/respond", {
        ticket: ticket,
        action: action,
        answer: answer
    })?
    print(if action == "answer" { "Answered " ++ ticket } else { action ++ "d " ++ ticket })
    Ok(nil)
}

fun printEventBatch(conn: Int, cursor: String) -> Result<String, Nil> {
    result = rpc(conn, 94, "agentManager/events", { cursor: cursor })?
    print("CURSOR\t" ++ fieldString(result, "cursor", "0"))
    match jsonGet(result, "data") {
        Some(JArr(events)) -> {
            for event in events { print(encodeJsonValue(event)) }
        }
        _ -> nil
    }
    Ok(nil)
}

fun dispatch(conn: Int, command: String, args: List<String>, options: Options) -> Result<String, Nil> {
    if command == "doctor" {
        print("OK: Funxy ${version} connected")
        Ok(nil)
    } else if command == "self-test" {
        selfTest(conn, options.cwd)
    } else if command == "list" {
        match listThreads(conn) {
            Ok(threads) -> {
                printThreads(threads)
                Ok(nil)
            }
            Fail(e) -> Fail(e)
        }
    } else if command == "start" && len(args) >= 2 {
        startAgent(conn, args[1], options)
    } else if command == "show" && len(args) >= 2 {
        showAgent(conn, args[1], options.cwd)
    } else if command == "send" && len(args) >= 3 {
        sendMessage(conn, args[1], options.cwd, stringJoin(drop(args, 2), " "))
    } else if command == "stop" && len(args) >= 2 {
        stopAgent(conn, args[1], options.cwd)
    } else if command == "resume" && len(args) >= 2 {
        resumeAgent(conn, args[1], options.cwd)
    } else if command == "remove" && len(args) >= 2 {
        removeAgent(conn, args[1], options.helper, options.cwd)
    } else if command == "watch" && len(args) >= 2 {
        watchAgent(conn, args[1], options.cwd, options.supervisorToken)
    } else if command == "events" {
        printEventBatch(conn, if len(args) >= 2 { args[1] } else { "tail" })
    } else if command == "pending" {
        printPendingRequests(conn)
    } else if command == "approve" && len(args) >= 2 {
        respondToPending(conn, args[1], "approve", "")
    } else if command == "approve-session" && len(args) >= 2 {
        respondToPending(conn, args[1], "approve-session", "")
    } else if command == "decline" && len(args) >= 2 {
        respondToPending(conn, args[1], "decline", "")
    } else if command == "cancel" && len(args) >= 2 {
        respondToPending(conn, args[1], "cancel", "")
    } else if command == "answer" && len(args) >= 3 {
        respondToPending(conn, args[1], "answer", stringJoin(drop(args, 2), " "))
    } else if command == "reconcile" {
        reconcileAgents(conn, options, len(args) >= 2 && args[1] == "--fix")
    } else if command == "ui" {
        tui(conn, options)
    } else {
        usage()
        Fail("invalid command or arguments")
    }
}

fun runManager(server: String, supervisorToken: String, command: String, args: List<String>, options: Options) -> Result<String, Nil> {
    conn = connect(server, supervisorToken)?
    result = dispatch(conn, command, args, options)
    wsClose(conn)
    result
}
