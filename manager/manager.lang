package manager (Options, managedName, runManager, usage, version)

import "lib/crypto" (sha256)
import "lib/list" (take)
import "lib/string" (stringTrim)
import "lib/sys" (sysExec)

type alias Options = {
    cwd: String,
    skill: String,
    promptText: String,
    model: String,
    vcs: String,
    approval: String,
    sandbox: String,
    workspace: String,
    helper: String,
    supervisorToken: String
}

prefix = "agent-manager:"
version = "0.6.0"

fun repositoryIdentity(cwd: String) -> String {
    commonDir = sysExec("git", ["-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"])
    if commonDir.code == 0 {
        stringTrim(commonDir.stdout)
    } else {
        root = sysExec("git", ["-C", cwd, "rev-parse", "--show-toplevel"])
        if root.code == 0 { stringTrim(root.stdout) } else { cwd }
    }
}

fun repositoryNamespace(cwd: String) -> String {
    take(sha256(repositoryIdentity(cwd)), 10)
}

fun managedName(task: String, cwd: String) -> String {
    prefix ++ repositoryNamespace(cwd) ++ ":" ++ task
}
