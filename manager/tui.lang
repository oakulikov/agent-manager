package manager

import "lib/json" (Json, jsonGet, jsonParse)
import "lib/list" (indexOf, map, nth, range)
import "lib/string" (stringJoin, stringReplace, stringSplit, stringTrim)
import "lib/term" (bold, confirm, cursorDown, cursorHide, cursorShow, cursorUp, cyan, dim, green, password, prompt, readKey, red, select, table, termClear, termClearLine, termIsTTY, termRaw, termRestore, yellow)
import "lib/tuple" (fst, snd)

actionNames = [
    "Start agent",
    "Show agent",
    "Send message",
    "Stop agent",
    "Resume agent",
    "Watch live events",
    "Pending requests",
    "Remove agent",
    "Refresh",
    "Quit"
]

actionKeys = ["s", "v", "m", "p", "r", "w", "a", "d", "f", "q"]

fun agentDisplayName(thread: Json, cwd: String) -> String {
    name = threadName(thread)
    localPrefix = prefix ++ repositoryNamespace(cwd) ++ ":"
    localName = stringReplace(name, localPrefix, "")
    if localName == name { stringReplace(name, prefix, "") } else { localName }
}

fun styledStatus(status: String) -> String {
    if status == "active" {
        green(status)
    } else if status == "paused" {
        yellow(status)
    } else {
        dim(status)
    }
}

fun printDashboard(threads: List<Json>, cwd: String) {
    print(bold(cyan("Codex Agent Manager")))
    print(dim("Persistent threads and isolated workspaces"))
    print("")
    if len(threads) == 0 {
        print(yellow("No managed agents"))
    } else {
        table(
            [bold("Agent"), bold("Status"), bold("Workspace")],
            map(fun(thread) -> [
                agentDisplayName(thread, cwd),
                styledStatus(threadStatus(thread)),
                fieldString(thread, "cwd", "?")
            ], threads)
        )
    }
    print("")
}

fun chooseAgent(threads: List<Json>, cwd: String) -> Option<String> {
    if len(threads) == 0 {
        print(yellow("There are no managed agents."))
        None
    } else {
        Some(select("Agent", map(fun(thread) -> agentDisplayName(thread, cwd), threads)))
    }
}

fun pauseUi() {
    prompt("Press Enter to continue", "")
    nil
}

fun finishUiAction(result: Result<String, Nil>) {
    match result {
        Ok(_) -> nil
        Fail(e) -> print(red("Error: " ++ e))
    }
    pauseUi()
}

fun optionLabel(option: Json) -> String {
    label = fieldString(option, "label", renderJson(option))
    description = fieldString(option, "description", "")
    if description == "" { label } else { label ++ " — " ++ description }
}

fun promptUserInput(params: Json) -> Result<String, String> {
    questions = match jsonGet(params, "questions") {
        Some(JArr(values)) -> values
        _ -> { return Fail("user-input request has no questions") }
    }
    answers = []
    for question in questions {
        questionId = fieldString(question, "id", "")
        if questionId == "" { return Fail("user-input question has no id") }
        print("")
        print(bold(fieldString(question, "header", questionId)))
        print(fieldString(question, "question", ""))
        answer = match jsonGet(question, "options") {
            Some(JArr(options)) -> {
                labels = map(optionLabel, options)
                choices = if fieldBool(question, "isOther", false) { labels ++ ["Other…"] } else { labels }
                chosen = select("Answer", choices)
                match indexOf(labels, chosen) {
                    Some(index) -> fieldString(nth(options, index), "label", chosen)
                    None -> if fieldBool(question, "isSecret", false) { password("Other answer") } else { prompt("Other answer", "") }
                }
            }
            _ -> if fieldBool(question, "isSecret", false) { password("Answer") } else { prompt("Answer", "") }
        }
        answers = answers ++ [(questionId, JObj([("answers", JArr([JStr(answer)]))]))]
    }
    Ok(encodeJsonValue(JObj(answers)))
}

fun schemaEnumValues(schema: Json) -> List<Json> {
    match jsonGet(schema, "enum") {
        Some(JArr(values)) -> values
        _ -> {
            match jsonGet(schema, "oneOf") {
                Some(JArr(options)) -> [
                    match jsonGet(option, "const") {
                        Some(value) -> value
                        None -> JStr(fieldString(option, "title", renderJson(option)))
                    }
                    | option <- options
                ]
                _ -> []
            }
        }
    }
}

fun promptSchemaValue(name: String, schema: Json) -> Result<String, Json> {
    description = fieldString(schema, "description", "")
    if description != "" { print(dim(description)) }
    valueType = fieldString(schema, "type", "string")
    if valueType == "boolean" {
        Ok(JBool(select(name, ["true", "false"]) == "true"))
    } else if valueType == "number" || valueType == "integer" {
        raw = prompt(name, renderJson(fieldObject(schema, "default")))
        match jsonParse(raw) {
            Ok(value) -> {
                match value {
                    JNum(_) -> Ok(value)
                    _ -> Fail(name ++ " must be a number")
                }
            }
            Fail(_) -> Fail(name ++ " must be a number")
        }
    } else if valueType == "array" {
        itemSchema = fieldObject(schema, "items")
        allowed = schemaEnumValues(itemSchema)
        if len(allowed) > 0 { print("Allowed values: " ++ stringJoin(map(renderJson, allowed), ", ")) }
        raw = prompt(name ++ " (comma-separated)", "")
        values = [JStr(stringTrim(value)) | value <- stringSplit(raw, ","), stringTrim(value) != ""]
        Ok(JArr(values))
    } else {
        allowed = schemaEnumValues(schema)
        if len(allowed) > 0 {
            labels = map(renderJson, allowed)
            chosen = select(name, labels)
            selectedIndex = match indexOf(labels, chosen) { Some(value) -> value None -> 0 }
            Ok(nth(allowed, selectedIndex))
        } else {
            Ok(JStr(prompt(name, fieldString(schema, "default", ""))))
        }
    }
}

fun promptMcpForm(params: Json) -> Result<String, String> {
    schema = fieldObject(params, "requestedSchema")
    properties = match jsonGet(schema, "properties") {
        Some(JObj(fields)) -> fields
        _ -> {
            raw = prompt("Answer JSON", "{}")
            jsonParse(raw)?
            return Ok(raw)
        }
    }
    content = []
    for property in properties {
        content = content ++ [(fst(property), promptSchemaValue(fst(property), snd(property))?)]
    }
    Ok(encodeJsonValue(JObj(content)))
}

fun handlePendingUi(conn: Int) -> Result<String, Nil> {
    items = getPendingRequests(conn)?
    if len(items) == 0 {
        print(yellow("There are no pending requests."))
        return Ok(nil)
    }
    labels = map(pendingRequestLabel, items)
    selected = select("Pending request", labels)
    selectedIndex = match indexOf(labels, selected) {
        Some(value) -> value
        None -> 0
    }
    item = nth(items, selectedIndex)
    ticket = fieldString(item, "ticket", "")
    request = fieldObject(item, "request")
    method = fieldString(request, "method", "")
    print(renderJson(fieldObject(request, "params")))
    if fieldString(item, "state", "stale") != "active" {
        Fail("this request is " ++ fieldString(item, "state", "stale") ++ " and belongs to an old App Server connection")
    } else if method == "item/tool/requestUserInput" {
        choice = select("Response", ["Answer all questions", "Decline", "Cancel"])
        if choice == "Decline" {
            respondToPending(conn, ticket, "decline", "")
        } else if choice == "Cancel" {
            respondToPending(conn, ticket, "cancel", "")
        } else {
            answer = promptUserInput(fieldObject(request, "params"))?
            respondToPending(conn, ticket, "answer", answer)
        }
    } else if method == "mcpServer/elicitation/request" {
        params = fieldObject(request, "params")
        mode = fieldString(params, "mode", "form")
        if mode == "url" {
            print("URL: " ++ fieldString(params, "url", ""))
            choice = select("Response", ["Accept", "Decline", "Cancel"])
            respondToPending(conn, ticket, if choice == "Accept" { "approve" } else if choice == "Decline" { "decline" } else { "cancel" }, "")
        } else {
            choice = select("Response", ["Answer form", "Decline", "Cancel"])
            if choice == "Answer form" {
                respondToPending(conn, ticket, "answer", promptMcpForm(params)?)
            } else {
                respondToPending(conn, ticket, if choice == "Decline" { "decline" } else { "cancel" }, "")
            }
        }
    } else {
        choice = select("Decision", ["Approve once", "Approve for session", "Decline", "Cancel"])
        action = if choice == "Approve once" { "approve" } else if choice == "Approve for session" { "approve-session" } else if choice == "Cancel" { "cancel" } else { "decline" }
        respondToPending(conn, ticket, action, "")
    }
}

fun renderActionMenu(selected: Int) {
    termClearLine()
    print("Action")
    for index in range(0, len(actionNames)) {
        termClearLine()
        marker = if index == selected { "  > " } else { "    " }
        print(marker ++ nth(actionNames, index) ++ " (" ++ nth(actionKeys, index) ++ ")")
    }
}

fun redrawActionMenu(selected: Int) {
    cursorUp(len(actionNames) + 1)
    renderActionMenu(selected)
}

fun clearActionMenu() {
    lines = len(actionNames) + 1
    cursorUp(lines)
    for index in range(0, lines) {
        termClearLine()
        if index < lines - 1 {
            cursorDown(1)
        }
    }
    cursorUp(lines - 1)
}

fun readAction(selected: Int) -> String {
    while true {
        key = readKey(100)
        match indexOf(actionKeys, key) {
            Some(index) -> { return nth(actionNames, index) }
            None -> {
                if key == "enter" {
                    return nth(actionNames, selected)
                } else if key == "up" {
                    next = if selected == 0 { len(actionNames) - 1 } else { selected - 1 }
                    redrawActionMenu(next)
                    return readAction(next)
                } else if key == "down" {
                    next = if selected == len(actionNames) - 1 { 0 } else { selected + 1 }
                    redrawActionMenu(next)
                    return readAction(next)
                }
            }
        }
    }
}

fun chooseAction() -> String {
    termRaw()
    cursorHide()
    renderActionMenu(0)
    action = readAction(0)
    clearActionMenu()
    termRestore()
    cursorShow()
    action
}

fun tui(conn: Int, options: Options) -> Result<String, Nil> {
    if !termIsTTY() {
        return Fail("ui requires an interactive terminal")
    }
    while true {
        termClear()
        threads = listThreads(conn)?
        printDashboard(threads, options.cwd)
        action = chooseAction()
        if action == "Quit" {
            return Ok(nil)
        } else if action == "Refresh" {
            nil
        } else if action == "Start agent" {
            task = prompt("Agent name or task ID", "")
            if task == "" {
                print(red("Agent name cannot be empty"))
                pauseUi()
            } else {
                extra = prompt("Additional instructions (optional)", options.promptText)
                finishUiAction(startAgent(conn, task, { ...options, promptText: extra }))
            }
        } else if action == "Pending requests" {
            finishUiAction(handlePendingUi(conn))
        } else {
            match chooseAgent(threads, options.cwd) {
                None -> pauseUi()
                Some(target) -> {
                    if action == "Show agent" {
                        finishUiAction(showAgent(conn, target, options.cwd))
                    } else if action == "Send message" {
                        message = prompt("Message", "")
                        if message == "" {
                            print(red("Message cannot be empty"))
                            pauseUi()
                        } else {
                            finishUiAction(sendMessage(conn, target, options.cwd, message))
                        }
                    } else if action == "Stop agent" {
                        finishUiAction(stopAgent(conn, target, options.cwd))
                    } else if action == "Resume agent" {
                        finishUiAction(resumeAgent(conn, target, options.cwd))
                    } else if action == "Watch live events" {
                        match watchAgentInteractive(conn, target, options.cwd, options.supervisorToken) {
                            Ok(_) -> nil
                            Fail(e) -> {
                                print(red("Error: " ++ e))
                                pauseUi()
                            }
                        }
                    } else if action == "Remove agent" {
                        if confirm("Remove " ++ target ++ " and its workspace?", false) {
                            finishUiAction(removeAgent(conn, target, options.helper, options.cwd))
                        }
                    }
                }
            }
        }
    }
    Ok(nil)
}
