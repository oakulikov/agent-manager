import "lib/flag" (*)
import "lib/io" (fileRead)
import "lib/json" (Json, jsonEncode, jsonGet, jsonParse)
import "lib/string" (stringIndexOf, stringTrim)
import "lib/time" (sleep)
import "lib/ws" (wsSend, wsServe)

flagSet("request-kind-file", "", "Optional file selecting approval, user, or mcp server requests")
flagSet("port", 15997, "Fake App Server WebSocket port")
flagParse()

fun requestKind() -> String {
    if flagGet("request-kind-file") == "" {
        "approval"
    } else {
        match fileRead(flagGet("request-kind-file")) {
            Ok(value) -> stringTrim(value)
            Fail(_) -> "approval"
        }
    }
}

fun contains(text: String, needle: String) -> Bool {
    match stringIndexOf(text, needle) {
        Some(_) -> true
        None -> false
    }
}

fun requestId(message: String) -> String {
    match jsonParse(message) {
        Ok(parsed) -> {
            match jsonGet(parsed, "id") {
                Some(JStr(value)) -> jsonEncode(value)
                Some(JNum(value)) -> show(value)
                _ -> "null"
            }
        }
        Fail(_) -> "null"
    }
}

fun handleMessage(conn: Int, message: String) -> String {
    if contains(message, "\"id\":\"approval-1\"") && contains(message, "\"result\"") {
        print("APPROVAL_RESPONSE " ++ message)
        `{"method":"serverRequest/resolved","params":{"threadId":"thread-1","requestId":"approval-1"}}`
    } else if contains(message, "\"id\":\"user-input-1\"") && contains(message, "\"result\"") {
        print("USER_INPUT_RESPONSE " ++ message)
        `{"method":"serverRequest/resolved","params":{"threadId":"thread-1","requestId":"user-input-1"}}`
    } else if contains(message, "\"id\":\"mcp-form-1\"") && contains(message, "\"result\"") {
        print("MCP_FORM_RESPONSE " ++ message)
        `{"method":"serverRequest/resolved","params":{"threadId":"thread-1","requestId":"mcp-form-1"}}`
    } else if contains(message, "\"method\":\"initialize\"") {
        `{"id":${requestId(message)},"result":{"userAgent":"fake-app-server"}}`
    } else if contains(message, "\"method\":\"thread/start\"") {
        `{"id":${requestId(message)},"result":{"thread":{"id":"rollback-thread"}}}`
    } else if contains(message, "\"method\":\"thread/name/set\"") {
        `{"id":${requestId(message)},"error":{"code":-32000,"message":"injected naming failure"}}`
    } else if contains(message, "\"method\":\"thread/delete\"") {
        print("ROLLED_BACK_THREAD")
        `{"id":${requestId(message)},"result":{}}`
    } else if contains(message, "\"method\":\"thread/resume\"") {
        `{"id":${requestId(message)},"result":{"thread":{"id":"managed-page-two","name":"agent-manager:page-two","cwd":"/tmp/page-two","status":{"type":"idle"}}}}`
    } else if contains(message, "\"method\":\"thread/read\"") {
        `{"id":${requestId(message)},"result":{"thread":{"id":"managed-page-two","name":"agent-manager:page-two","cwd":"/tmp/page-two","status":{"type":"idle"},"turns":[]}}}`
    } else if contains(message, "\"method\":\"thread/goal/get\"") {
        `{"id":${requestId(message)},"result":{"goal":{"objective":"fake","status":"paused"}}}`
    } else if contains(message, "\"method\":\"thread/list\"") && contains(message, "page-2") {
        wsSend(conn, `{"method":"thread/status/changed","params":{"threadId":"managed-page-two","status":{"type":"idle"}}}`)
        `{"id":${requestId(message)},"result":{"data":[{"id":"managed-page-two","name":"agent-manager:page-two","cwd":"/tmp/page-two","status":{"type":"idle"}}],"nextCursor":null}}`
    } else if contains(message, "\"method\":\"thread/list\"") {
        kind = requestKind()
        if kind == "none" {
            nil
        } else if kind == "user" {
            wsSend(conn, `{"id":"user-input-1","method":"item/tool/requestUserInput","params":{"itemId":"item-2","threadId":"thread-1","turnId":"turn-1","autoResolutionMs":null,"questions":[{"id":"environment","header":"Environment","question":"Where should this run?","options":[{"label":"staging","description":"Safe test target"},{"label":"production","description":"Live target"}]},{"id":"confirm","header":"Confirm","question":"Continue?","options":[{"label":"yes","description":"Proceed"},{"label":"no","description":"Stop"}]}]}}`)
        } else if kind == "mcp" {
            wsSend(conn, `{"id":"mcp-form-1","method":"mcpServer/elicitation/request","params":{"threadId":"thread-1","turnId":"turn-1","serverName":"fake-mcp","mode":"form","message":"Deployment settings","requestedSchema":{"type":"object","properties":{"environment":{"type":"string","enum":["staging","production"]},"replicas":{"type":"integer"}},"required":["environment"]}}}`)
        } else {
            wsSend(conn, `{"id":"approval-1","method":"item/commandExecution/requestApproval","params":{"itemId":"item-1","threadId":"thread-1","turnId":"turn-1","command":"false"}}`)
        }
        `{"id":${requestId(message)},"result":{"data":[{"id":"unmanaged-page-one","name":"another-client","cwd":"/tmp/page-one","status":{"type":"idle"}}],"nextCursor":"page-2"}}`
    } else {
        `{"method":"fake/ignored","params":{}}`
    }
}

wsServe(flagGet("port"), handleMessage)

while true {
    sleep(1)
}
